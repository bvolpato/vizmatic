{
  "name": "vizmatic",
  "version": "0.4.0",
  "description": "Theme-aware diagrams, charts, animations, and MP4 video from TSX.",
  "type": "module",
  "license": "MIT",
  "author": "Bruno Volpato",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://bvolpato.github.io/vizmatic/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvolpato/vizmatic.git"
  },
  "bugs": {
    "url": "https://github.com/bvolpato/vizmatic/issues"
  },
  "keywords": [
    "visualization",
    "satori",
    "resvg",
    "react",
    "diagrams",
    "presentations",
    "animation",
    "video",
    "mp4",
    "theme-aware",
    "ai-agents",
    "structured-visuals"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "assets/emoji.json.br",
    "assets/fonts",
    "assets/licenses",
    "assets/THIRD_PARTY_LICENSES.md",
    "dist",
    "examples",
    "PROMPT.md",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./scene-runtime": {
      "import": { "types": "./dist/scene-runtime.d.ts", "default": "./dist/scene-runtime.js" },
      "require": { "types": "./dist/scene-runtime.d.cts", "default": "./dist/scene-runtime.cjs" }
    },
    "./scene-browser": {
      "types": "./dist/scene-browser.d.ts",
      "import": "./dist/scene-browser.js"
    },
    "./browser-assets": {
      "types": "./dist/scene-browser-assets.d.ts",
      "import": "./dist/scene-browser-assets.js"
    }
  },
  "bin": {
    "vizmatic": "dist/cli.js",
    "vizmatic-scene": "dist/scene-cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/scene-runtime.ts --format esm --dts --target node20 --clean --external react && tsup src/index.ts src/scene-runtime.ts --format cjs --dts --target node20 --external react --define.import.meta.url undefined && tsup src/cli.ts src/scene-cli.ts --format esm --dts --target node20 --external react --minify-whitespace && pnpm build:browser",
    "build:browser": "tsup src/scene-browser.ts --dts-only --format esm --target es2022 --external react && tsup src/scene-browser-assets.ts --format esm --dts --target node20 && tsx scripts/build-scene-browser.ts",
    "assets:emoji": "node scripts/build-emoji-bundle.mjs",
    "assets:check": "node scripts/build-emoji-bundle.mjs --check",
    "prepare": "pnpm build",
    "lint": "pnpm typecheck && pnpm workflows:check",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "render:examples": "pnpm build && tsx scripts/render-examples.ts && pnpm site:build",
    "render:video": "pnpm build && tsx scripts/render-video-example.ts",
    "benchmark:quality": "pnpm build && tsx scripts/benchmark-quality.ts && pnpm site:build",
    "check:examples": "tsx scripts/check-examples.ts",
    "playground:build": "tsx scripts/build-playground.ts",
    "check:playground": "node scripts/check-playground.mjs",
    "check:scene-browser": "node scripts/check-scene-browser.mjs",
    "site:build": "tsx scripts/build-site.ts",
    "site:fonts": "uv run scripts/build-site-fonts.py",
    "docs:check": "tsx scripts/check-docs.ts",
    "workflows:check": "github-actionlint .github/workflows/*.yml",
    "site:serve": "node scripts/serve-docs.mjs docs 4173",
    "sync:plugin-versions": "node scripts/sync-plugin-versions.mjs",
    "security:audit": "pnpm audit --audit-level low",
    "deps:check": "pnpm security:audit && pnpm assets:check && publint && tsx scripts/check-package.ts && node scripts/check-consumer.mjs",
    "verify": "pnpm lint && pnpm test && pnpm render:examples && pnpm check:examples && pnpm docs:check && pnpm deps:check",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "2.6.2",
    "gifenc": "^1.0.3",
    "mathjax-full": "3.2.2",
    "parse-css-color": "0.2.1",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.2.8",
    "satori": "0.41.0",
    "sucrase": "3.35.1",
    "tsx": "^4.23.12"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "esbuild": "0.28.2",
    "github-actionlint": "1.7.12",
    "harfbuzzjs": "0.10.0",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "shiki": "^4.5.0",
    "tsup": "^8.5.1",
    "typescript": ">=6.0.3 <7",
    "vitest": "^5.0.3"
  }
}
