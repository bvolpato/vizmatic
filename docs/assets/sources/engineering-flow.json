   { id: 'cache', label: 'Cache lookup', detail: 'match reusable bytes', x: 0.66, y: 0.50, tone: 'purple' },\n            { id: 'model', label: 'Model response', detail: 'less uncached input', x: 0.92, y: 0.50, tone: 'green' },\n        ]}\n        edges={[\n            { from: 'prefix', to: 'turn', label: 'append' },\n            { from: 'turn', to: 'cache', label: 'send' },\n            { from: 'cache', to: 'model', label: 'reuse' },\n        ]}\n    />\n    <Row width=\"100%\" gap={16} align=\"stretch\">\n        <MetricCard\n            label=\"Warm cache read\"\n            value=\"84%\"\n            detail=\"sample after change\"\n            tone=\"green\"\n            width={250}\n            valueFontSize={25}\n        />\n        <MetricCard\n            label=\"Uncached input\"\n            value=\"-71%\"\n            detail=\"sample per task\"\n            tone=\"purple\"\n            width={250}\n            valueFontSize={25}\n        />\n        <CalloutCard\n            title=\"Request layout example\"\n            detail=\"Place volatile fields after reusable context and preserve provider cache controls.\"\n            tone=\"blue\"\n            width={420}\n            align=\"left\"\n        />\n    </Row>\n</Scene>\n"}