de></pre>"},"playgroundCode":"width = 1280\nheight = 720\nconst __vizmaticExampleTheme = c.bg === getThemeColors('dark').bg ? 'dark' : 'light';\nconst width = 1280;\nconst height = 720;\nfunction create(theme: ThemeMode = 'dark') {\n    const c = getThemeColors(theme);\n    return (<Scene c={c} title=\"Physics · net force and wave interference\" subtitle=\"Resolve forces into a net vector, then see how coherent waves superpose.\" background={c.bg} padding={24} gap={16}>\n            <Row width=\"100%\" gap={16} align=\"stretch\">\n                <Panel c={c} title=\"A cart accelerates right\" subtitle=\"Vertical forces cancel; horizontal forces leave a 5 N resultant.\" tone=\"green\" width={608} minHeight={520} align=\"center\" padding={0} footer=\"ΣFₓ = 8 N − 3 N = 5 N · ΣFᵧ = 9.8 N − 9.8 N = 0\">\n                    <FreeBodyDiagram c={c} width={600} height={360} forces={[\n            { id: 'weight', label: 'weight · 9.8 N', x: 0, y: -9.8, color: c.primary },\n            { id: 'normal', label: 'normal · 9.8 N', x: 0, y: 9.8, color: c.info },\n            { id: 'push', label: 'push · 8 N', x: 8, y: 0, color: c.positive },\n            { id: 'drag', label: 'drag · 3 N', x: -3, y: 0, color: c.warning },\n        ]} showComponents showResultant/>\n                    <TextLabel c={c} text=\"The resultant points right, so the cart's velocity changes in that direction.\" fontSize={12} color={c.textSecondary}/>\n                </Panel>\n\n                <Panel c={c} title=\"In-phase wave superposition\" subtitle=\"Two equal waves add point by point to a wave with twice the amplitude.\" tone=\"purple\" width={608} minHeight={520} align=\"center\" padding={0} footer=\"Illustrative sinusoidal waves · A = 1 m each · λ = 4 m\">\n                    <WaveDiagram c={c} width={600} height={360} waves={[\n            { amplitude: 1, wavelength: 4, phase: 0, color: c.info, label: 'wave 1 · A' },\n            { amplitude: 1, wavelength: 4, phase: 0, color: c.primary, label: 'wave 2 · A' },\n        ]} time={0} xMin={-4} xMax={4} yMin={-2.4} yMax={2.4} showComponents showSum/>\n                    <TextLabel c={c} text=\"At matching crests and troughs, the displacement adds to ±2A.\" fontSize={12} color={c.textSecondary}/>\n                </Panel>\n            </Row>\n        </Scene>);\n}\n<React.Fragment>{create(__vizmaticExampleTheme)}</React.Fragment>"}