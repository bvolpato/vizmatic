{"name":"catalog-science-math","title":"Catalog Science Math","source":"examples/catalog-science-math.tsx","code":"import {\n    GeometryDiagram,\n    getThemeColors,\n    NumberLine,\n    Panel,\n    Row,\n    Scene,\n    TextLabel,\n    type ThemeMode,\n} from 'vizmatic'\n\nexport const width = 1280\nexport const height = 720\n\nexport function create(theme: ThemeMode = 'dark') {\n    const c = getThemeColors(theme)\n\n    return (\n        <Scene\n            c={c}\n            title=\"Math · intervals and geometric proof\"\n            subtitle=\"Make endpoint conventions and measurable relationships visible in one frame.\"\n            background={c.bg}\n            padding={24}\n            gap={16}\n        >\n            <Row width=\"100%\" gap={16} align=\"stretch\">\n                <Panel\n                    c={c}\n                    title=\"A half-open interval\"\n                    subtitle=\"The left endpoint is included; the right endpoint is excluded.\"\n                    tone=\"purple\"\n                    width={608}\n                    minHeight={510}\n                    align=\"center\"\n                    padding={0}\n                    footer=\"The hollow endpoint at 2 distinguishes x < 2 from x ≤ 2.\"\n                >\n                    <NumberLine\n                        c={c}\n                        width={600}\n                        height={380}\n                        min={-3}\n                        max={3}\n                        ticks={[\n                            { value: -2, label: '−2' },\n                            { value: -1, label: '−1' },\n                            { value: 0, label: '0' },\n                            { value: 1, label: '1' },\n                            { value: 2, label: '2' },\n                        ]}\n                        markers={[{ id: 'origin', label: 'origin', value: 0, color: c.info }]}\n                        interval={{\n                            from: -1.5,\n                            to: 2,\n                            includeFrom: true,\n                            includeTo: false,\n                            label: '−3/2 ≤ x < 2',\n                            color: c.primary,\n                        }}\n                    />\n                    <TextLabel c={c} text=\"Every point on the shaded segment satisfies the inequality.\" fontSize={13} color={c.textSecondary} />\n                </Panel>\n\n                <Panel\n                    c={c}\n                    title=\"A 3–4–5 right triangle\"\n                    subtitle=\"Coordinates make the side lengths and right angle verifiable.\"\n                    tone=\"blue\"\n                    width={608}\n                    minHeight={510}\n                    align=\"center\"\n                    padding={0}\n                    footer=\"AB² + BC² = AC² · 4² + 3² = 5²\"\n                >\n                    <GeometryDiagram\n                        c={c}\n                        width={600}\n                        height={360}\n                        points={[\n                            { id: 'A', x: 0, y: 0, label: 'A' },\n                            { id: 'B', x: 4, y: 0, label: 'B' },\n                            { id: 'C', x: 4, y: 3, label: 'C' },\n                        ]}\n                        segments={[\n                            { from: 'A', to: 'B', label: '4 units', color: c.secondary },\n                            { from: 'B', to: 'C', label: '3 units', color: c.info },\n                            { from: 'A', to: 'C', label: '5 units', color: c.primary },\n                        ]}\n                        angles={[{ vertex: 'B', from: 'A', to: 'C', label: '90°', color: c.warning }]}\n                    />\n                    <TextLabel c={c} text=\"The longest side is opposite the right angle.\" fontSize={13} color={c.textSecondary} />\n                </Panel>\n            </Row>\n        </Scene>\n    )\n}\n\nexport default create('dark')\n","html":{"dark":"<pre class=\"shiki github-dark-high-contrast\" style=\"background-color:#0a0c10;color:#f0f3f6\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#FF9492\">import</span><span style=\"color:#F0F3F6\"> {</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    GeometryDiagram,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    getThemeColors,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    NumberLine,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    Panel,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    Row,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    Scene,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    TextLabel,</span></span>\n<span class=\"line\"><span style=\"color:#FF9492\">    type</span><span style=\"color:#F0F3F6\"> ThemeMode,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">} </span><span style=\"color:#FF9492\">from</span><span style=\"color:#ADDCFF\"> 'vizmatic'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#FF9492\">export</span><span style=\"color:#FF9492\"> const</span><span style=\"color:#91CBFF\"> width</span><span style=\"color:#FF9492\"> =</span><span style=\"color:#91CBFF\"> 1280</span></span>\n<span class=\"line\"><span style=\"color:#FF9492\">export</span><span style=\"color:#FF9492\"> const</span><span style=\"color:#91CBFF\"> height</span><span style=\"color:#FF9492\"> =</span><span style=\"color:#91CBFF\"> 720</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#FF9492\">export</span><span style=\"color:#FF9492\"> function</span><span style=\"color:#DBB7FF\"> create</span><span style=\"color:#F0F3F6\">(</span><span style=\"color:#FFB757\">theme</span><span style=\"color:#FF9492\">:</span><span style=\"color:#FFB757\"> ThemeMode</span><span style=\"color:#FF9492\"> 