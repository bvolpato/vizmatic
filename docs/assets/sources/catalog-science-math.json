yle=\"color:#0E1116\">, to: </span><span style=\"color:#032563\">'B'</span><span style=\"color:#0E1116\">, label: </span><span style=\"color:#032563\">'4 units'</span><span style=\"color:#0E1116\">, color: c.secondary },</span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">                            { from: </span><span style=\"color:#032563\">'B'</span><span style=\"color:#0E1116\">, to: </span><span style=\"color:#032563\">'C'</span><span style=\"color:#0E1116\">, label: </span><span style=\"color:#032563\">'3 units'</span><span style=\"color:#0E1116\">, color: c.info },</span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">                            { from: </span><span style=\"color:#032563\">'A'</span><span style=\"color:#0E1116\">, to: </span><span style=\"color:#032563\">'C'</span><span style=\"color:#0E1116\">, label: </span><span style=\"color:#032563\">'5 units'</span><span style=\"color:#0E1116\">, color: c.primary },</span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">                        ]</span><span style=\"color:#A0111F\">}</span></span>\n<span class=\"line\"><span style=\"color:#023B95\">                        angles</span><span style=\"color:#A0111F\">={</span><span style=\"color:#0E1116\">[{ vertex: </span><span style=\"color:#032563\">'B'</span><span style=\"color:#0E1116\">, from: </span><span style=\"color:#032563\">'A'</span><span style=\"color:#0E1116\">, to: </span><span style=\"color:#032563\">'C'</span><span style=\"color:#0E1116\">, label: </span><span style=\"color:#032563\">'90°'</span><span style=\"color:#0E1116\">, color: c.warning }]</span><span style=\"color:#A0111F\">}</span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">                    /></span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">                    &#x3C;</span><span style=\"color:#024C1A\">TextLabel</span><span style=\"color:#023B95\"> c</span><span style=\"color:#A0111F\">={</span><span style=\"color:#0E1116\">c</span><span style=\"color:#A0111F\">}</span><span style=\"color:#023B95\"> text</span><span style=\"color:#A0111F\">=</span><span style=\"color:#032563\">\"The longest side is opposite the right angle.\"</span><span style=\"color:#023B95\"> fontSize</span><span style=\"color:#A0111F\">={</span><span style=\"color:#023B95\">13</span><span style=\"color:#A0111F\">}</span><span style=\"color:#023B95\"> color</span><span style=\"color:#A0111F\">={</span><span style=\"color:#0E1116\">c.textSecondary</span><span style=\"color:#A0111F\">}</span><span style=\"color:#0E1116\"> /></span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">                &#x3C;/</span><span style=\"color:#024C1A\">Panel</span><span style=\"color:#0E1116\">></span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">            &#x3C;/</span><span style=\"color:#024C1A\">Row</span><span style=\"color:#0E1116\">></span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">        &#x3C;/</span><span style=\"color:#024C1A\">Scene</span><span style=\"color:#0E1116\">></span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">    )</span></span>\n<span class=\"line\"><span style=\"color:#0E1116\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#A0111F\">export</span><span style=\"color:#A0111F\"> default</span><span style=\"color:#622CBC\"> create</span><span style=\"color:#702C00\">(</span><span style=\"color:#032563\">'dark'</span><span style=\"color:#702C00\">)</span></span>\n<span class=\"line\"></span></code></pre>"},"playgroundCode":"width = 1280\nheight = 720\nconst __vizmaticExampleTheme = c.bg === getThemeColors('dark').bg ? 'dark' : 'light';\nconst width = 1280;\nconst height = 720;\nfunction create(theme: ThemeMode = 'dark') {\n    const c = getThemeColors(theme);\n    return (<Scene c={c} title=\"Math · intervals and geometric proof\" subtitle=\"Make endpoint conventions and measurable relationships visible in one frame.\" background={c.bg} padding={24} gap={16}>\n            <Row width=\"100%\" gap={16} align=\"stretch\">\n                <Panel c={c} title=\"A half-open interval\" subtitle=\"The left endpoint is included; the right endpoint is excluded.\" tone=\"purple\" width={608} minHeight={510} align=\"center\" padding={0} footer=\"The hollow endpoint at 2 distinguishes x < 2 from x ≤ 2.\">\n                    <NumberLine c={c} width={600} height={380} min={-3} max={3} ticks={[\n            { value: -2, label: '−2' },\n            { value: -1, label: '−1' },\n            { value: 0, label: '0' },\n            { value: 1, label: '1' },\n            { value: 2, label: '2' },\n        ]} markers={[{ id: 'origin', label: 'origin', value: 0, color: c.info }]} interval={{\n            from: -1.5,\n            to: 2,\n            includeFrom: true,\n            includeTo: false,\n            label: '−3/2 ≤ x < 2',\n            color: c.primary,\n        }}/>\n                    <TextLabel c={c} text=\"Every point on the shaded segment satisfies the inequality.\" fontSize={13} color={c.textSecondary}/>\n                </Panel>\n\n                <Panel c={c} title=\"A 3–4–5 right triangle\" subtitle=\"Coordinates make the side lengths and right angle verifiable.\" tone=\"blue\" width={608} minHeight={510} align=\"center\" padding={0} footer=\"AB² + BC² = AC² · 4² + 3² = 5²\">\n                    <GeometryDiagram c={c} width={600} height={360} points={[\n            { id: 'A', x: 0, y: 0, label: 'A' },\n            { id: 'B', x: 4, y: 0, label: 'B' },\n            { id: 'C', x: 4, y: 3, label: 'C' },\n        ]} segments={[\n            { from: 'A', to: 'B', label: '4 units', color: c.secondary },\n            { from: 'B', to: 'C', label: '3 units', color: c.info },\n            { from: 'A', to: 'C', label: '5 units', color: c.primary },\n        ]} angles={[{ vertex: 'B', from: 'A', to: 'C', label: '90°', color: c.warning }]}/>\n                    <TextLabel c={c} text=\"The longest side is opposite the right angle.\" fontSize={13} color={c.textSecondary}/>\n                </Panel>\n            </Row>\n        </Scene>);\n}\n<React.Fragment>{create(__vizmaticExampleTheme)}</React.Fragment>"}