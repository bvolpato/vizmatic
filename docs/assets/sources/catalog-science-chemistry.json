element\" subtitle=\"The coefficients balance four hydrogen atoms and two oxygen atoms on both sides.\" tone=\"blue\" width={776} minHeight={344} align=\"center\" justify=\"center\" footer=\"2 H₂(g) + O₂(g) → 2 H₂O(l) · atom counts match\">\n                    <ReactionEquation c={c} width={720} reactants={[\n            { formula: 'H₂', coefficient: 2, state: 'g', composition: { H: 2 } },\n            { formula: 'O₂', state: 'g', composition: { O: 2 } },\n        ]} products={[\n            { formula: 'H₂O', coefficient: 2, state: 'l', composition: { H: 2, O: 1 } },\n        ]} conditions=\"spark ignition · hydrogen combustion\"/>\n                </Panel>\n            </Row>\n\n            <Panel c={c} title=\"A catalyst changes the path, not the endpoints\" subtitle=\"Both pathways begin and end at the same energies; the catalyzed route has a smaller activation barrier.\" tone=\"purple\" width=\"100%\" minHeight={350} align=\"center\" footer=\"Illustrative relative energy values · not measured data for hydrogen combustion\">\n                <ReactionEnergyDiagram c={c} width={1150} height={320} reactants={0} products={-100} barrier={140} catalyzedBarrier={70} unit=\"relative energy\" reactantLabel=\"reactants\" productLabel=\"products\"/>\n            </Panel>\n        </Scene>);\n}\n<React.Fragment>{create(__vizmaticExampleTheme)}</React.Fragment>"}