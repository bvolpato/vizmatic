{"name":"pie-chart","title":"Pie Chart","source":"examples/pie-chart.tsx","code":"import {\n    PieChart,\n    Scene,\n    getThemeColors,\n    type ThemeMode,\n} from 'vizmatic'\n\nexport const width = 1040\nexport const height = 570\n\nconst tickets = [\n    { label: 'Setup', value: 42, color: 'primary' },\n    { label: 'Authentication', value: 28, color: 'secondary' },\n    { label: 'Slow responses', value: 18, color: 'warning' },\n    { label: 'Other', value: 12, color: 'neutral' },\n]\n\nexport function create(theme: ThemeMode = 'dark') {\n    const c = getThemeColors(theme)\n\n    return (\n        <Scene\n            c={c}\n            title=\"See where the support load comes from\"\n            subtitle=\"A pie chart shows each category as a share of all reported tickets\"\n            background={c.bg}\n            padding={22}\n            gap={14}\n            align=\"center\"\n        >\n            <PieChart\n                c={c}\n                width={920}\n                height={310}\n                size={220}\n                title=\"Support tickets by root cause\"\n                subtitle=\"42 of 100 reports are setup questions\"\n                format=\"integer\"\n                segments={tickets}\n                footer=\"Sample: 100 tickets from the past seven days\"\n            />\n        </Scene>\n    )\n}\n\nexport default create('dark')\n","html":{"dark":"<pre class=\"shiki github-dark-high-contrast\" style=\"background-color:#0a0c10;color:#f0f3f6\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#FF9492\">import</span><span style=\"color:#F0F3F6\"> {</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    PieChart,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    Scene,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    getThemeColors,</span></span>\n<span class=\"line\"><span style=\"color:#FF9492\">    type</span><span style=\"color:#F0F3F6\"> ThemeMode,</span></s