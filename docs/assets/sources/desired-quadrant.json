sitive',\n                        emphasis: true,\n                    },\n                    topRight: {\n                        label: 'PREMIUM PERFORMANCE',\n                        detail: 'high score · higher cost',\n                        color: 'warning',\n                    },\n                    bottomLeft: {\n                        label: 'BUDGET TRADEOFF',\n                        detail: 'lower score · lower cost',\n                        color: 'info',\n                    },\n                    bottomRight: {\n                        label: 'LOW EFFICIENCY',\n                        detail: 'lower score · higher cost',\n                        color: 'critical',\n                    },\n                }}\n                points={points}\n                footer=\"Threshold axes: cost ≤ $0.20 and weighted score ≥ 70\"\n            />\n        </Scene>\n    )\n}\n\nexport default create('dark')\n","html":{"dark":"<pre class=\"shiki github-dark-high-contrast\" style=\"background-color:#0a0c10;color:#f0f3f6\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#FF9492\">import</span><span style=\"color:#F0F3F6\"> {</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    QuadrantChart,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    Scene,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">    getThemeColors,</span></span>\n<span class=\"line\"><span style=\"color:#FF9492\">    type</span><span style=\"color:#F0F3F6\"> ThemeMode,</span></span>\n<span class=\"line\"><span style=\"color:#F0F3F6\">} </span><span style=\"color:#FF9492\">from</span><span style=\"color:#ADDCFF\"> 'vizmatic'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#FF9492\">export</span><span style=\"color:#FF9492\"> const</span><span style=\"color:#91CBFF\"> width</span><span style=\"color:#FF9492\"> =</span><span style=\"color:#91CBFF\"> 1040</span></span>\n<span class=\"line\"><spa